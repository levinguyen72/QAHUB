DATABASE_URL=postgresql://ospm:ospm@localhost:5432/ospm
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Kho file đính kèm: 'local' = lưu đĩa (mặc định, không cần MinIO/S3); 's3' = MinIO/S3.
STORAGE_DRIVER=local
# Driver 'local': thư mục chứa file (VPS nên trỏ tới volume cố định, vd /var/lib/ospm/storage)
STORAGE_DIR=./var/storage
# Base URL công khai để tạo link upload/download đã ký. Local: http://localhost:3000; VPS: https://<domain>
STORAGE_PUBLIC_URL=http://localhost:3000
# Driver 's3' mới cần các biến dưới (bỏ qua khi dùng 'local'):
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=attachments
S3_PUBLIC_ENDPOINT=http://localhost:9000
WEB_ORIGIN=http://localhost:5173
INGEST_MAX_RESULTS_PER_RUN=5000
SEED_ADMIN_PASSWORD=Admin@12345
PORT=3000
